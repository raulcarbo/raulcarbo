<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_update_purchase_frequency" model="ir.cron">
        <field name="name">Carbotecnia: recalcular frecuencia de compra</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_purchase_frequency()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Acción manual disponible en el menú Acciones de Contactos -->
    <record id="action_server_update_purchase_frequency" model="ir.actions.server">
        <field name="name">Actualizar frecuencia de compra (todos)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form,kanban</field>
        <field name="state">code</field>
        <field name="code">model._cron_update_purchase_frequency()</field>
    </record>
</odoo>
