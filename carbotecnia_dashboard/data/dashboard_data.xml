<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Dashboard de ejemplo: editable/borrable desde Dashboard CT → Configuración -->
    <record id="dashboard_ventas_ejemplo" model="carbo.dashboard">
        <field name="name">Ventas (ejemplo)</field>
        <field name="sequence">10</field>
    </record>

    <record id="widget_ejemplo_kpi_total" model="carbo.dashboard.widget">
        <field name="dashboard_id" ref="dashboard_ventas_ejemplo"/>
        <field name="name">Ventas del año</field>
        <field name="sequence">1</field>
        <field name="display_type">kpi</field>
        <field name="col_span">4</field>
        <field name="source">model</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain">[("state", "not in", ["draft", "sent", "cancel"]), ("date", "&gt;=", (context_today() + relativedelta(month=1, day=1)).strftime("%Y-%m-%d"))]</field>
        <field name="aggregate">sum</field>
        <field name="measure_field_id" ref="sale.field_sale_report__price_total"/>
        <field name="is_money" eval="True"/>
    </record>

    <record id="widget_ejemplo_vendedor" model="carbo.dashboard.widget">
        <field name="dashboard_id" ref="dashboard_ventas_ejemplo"/>
        <field name="name">Ventas por vendedor (año)</field>
        <field name="sequence">2</field>
        <field name="display_type">chart</field>
        <field name="chart_type">bar</field>
        <field name="col_span">8</field>
        <field name="source">model</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain">[("state", "not in", ["draft", "sent", "cancel"]), ("date", "&gt;=", (context_today() + relativedelta(month=1, day=1)).strftime("%Y-%m-%d"))]</field>
        <field name="groupby_field_id" ref="sale.field_sale_report__user_id"/>
        <field name="aggregate">sum</field>
        <field name="measure_field_id" ref="sale.field_sale_report__price_total"/>
        <field name="is_money" eval="True"/>
    </record>

    <record id="widget_ejemplo_categoria" model="carbo.dashboard.widget">
        <field name="dashboard_id" ref="dashboard_ventas_ejemplo"/>
        <field name="name">Ventas por categoría (año)</field>
        <field name="sequence">3</field>
        <field name="display_type">chart</field>
        <field name="chart_type">doughnut</field>
        <field name="col_span">6</field>
        <field name="source">model</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain">[("state", "not in", ["draft", "sent", "cancel"]), ("date", "&gt;=", (context_today() + relativedelta(month=1, day=1)).strftime("%Y-%m-%d"))]</field>
        <field name="groupby_field_id" ref="sale.field_sale_report__categ_id"/>
        <field name="aggregate">sum</field>
        <field name="measure_field_id" ref="sale.field_sale_report__price_total"/>
        <field name="is_money" eval="True"/>
    </record>

    <record id="widget_ejemplo_tendencia" model="carbo.dashboard.widget">
        <field name="dashboard_id" ref="dashboard_ventas_ejemplo"/>
        <field name="name">Tendencia mensual (12 meses)</field>
        <field name="sequence">4</field>
        <field name="display_type">chart</field>
        <field name="chart_type">line</field>
        <field name="col_span">6</field>
        <field name="source">model</field>
        <field name="model_id" ref="sale.model_sale_report"/>
        <field name="domain">[("state", "not in", ["draft", "sent", "cancel"]), ("date", "&gt;=", (context_today() - relativedelta(months=11)).strftime("%Y-%m-01"))]</field>
        <field name="groupby_field_id" ref="sale.field_sale_report__date"/>
        <field name="date_granularity">month</field>
        <field name="aggregate">sum</field>
        <field name="measure_field_id" ref="sale.field_sale_report__price_total"/>
        <field name="limit">12</field>
        <field name="is_money" eval="True"/>
    </record>
</odoo>
